{
  "name": "honeymoon-bridge-web",
  "private": true,
  "type": "module",
  "description": "蜜月橋牌網頁連線版：Cloudflare Workers + Durable Objects 雲端開房",
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --format=esm --target=es2020 --minify --sourcemap --outfile=public/app.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
