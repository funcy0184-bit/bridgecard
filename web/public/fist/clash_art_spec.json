  "rules": {
    "trigger": {
      "metric": "accumulatedDraws",
      "threshold": 2,
      "requiresConsecutive": false
    },
    "clashCount": 5,
    "finisherSelector": "highestWinningGestureCount",
    "countOnly": "beats won by the already resolved winner",
    "excludeDraws": true,
    "tiedMaximum": "use game-provided resolvedFinisherGesture among tied leaders",
    "noResolvedWinner": "do not trigger a victory finisher"
  },
