  "ordinaryContact": {
    "asset": "vfx_clash_spark.png",
    "anchor": "weaponContact",
    "loserAnimation": "clash_recoil",
    "cameraShakePx": 1,
    "hitstopMs": 45
  },
  "presentation": {
    "units": {
      "cameraShakePx": "peak displacement in virtual pixels",
      "hitstopMs": "milliseconds"
    },
    "eventTiming": "0-based. Fire once on entering the marked frame, before hitstop. Visual events never determine the winner. Freeze fighter and impact animation together during hitstop.",
    "attachments": {
      "targetGround": "surface at target feet",
      "targetChestAtPassThrough": "snapshot target chest position when the attacker passes frame 3; trigger impact at fighter frame 5",
      "winnerPalm": "from fighter cell origin at cellPositionPx, extend toward facing direction"
    },
    "jumpOffset": "apply renderOffsetYPxByFrame to the sprite origin only; world foot anchor stays fixed",
    "crossing": "resolve side change from game world positions at crossTargetFrame; artwork stays right-facing",
    "mirror": "mirror around the fighter or effect pivot when facing left",
    "reducedMotion": {
      "cameraShakePx": 0,
      "flashFrameReplacement": "clash_recoil frame 1"
    }
  },
