  "eventContract": {
    "allin_loss": "梭哈方已遭接戰並在該墩輸掉，且該結果成為結算主事件；不推斷其意圖。",
    "allin_win": "梭哈已接戰，主動梭哈方贏下對局或高額墩。",
    "fold_win": "以棄牌決定該墩；不得宣稱翻牌後牌力孰強。",
    "bluff_verified": "僅在雙方賽後同意揭露該墩隱藏牌且後端確定棄牌者本可獲勝時成立。",
    "vow_backfire": "賽前豪言非空，發言者為本場落敗者；只做原句回放，不判定句義。",
    "last_trick_comeback": "第9墩結算前非領先、結算後嚴格領先，且比賽於第9墩結束。",
    "tie_pool": "雙方實際翻牌且同點，賭盤依規則保留。",
    "safeguard_save": "保命實際避免超過1枚的損失；單純宣告不算。",
    "finish_draw": "第9墩結算後，雙方手上籌碼相等且全部未決賭盤已依出資退款。"
  },
  "contentSafety": {
    "scope": "全部僅在局內虛擬籌碼；彩頭不涉及現金交易、不強制現實履約。",
    "input": "限制長度；escape HTML；過濾網址/個資/侮辱性或仇恨內容；支援檢舉與關閉自訂字詞。",
    "privacy": "棄牌未公開的實際牌點，在雙方同意賽後揭露前不可由任何模板推斷或輸出。"
  },
