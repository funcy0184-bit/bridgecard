{
  // 手機瀏覽器這一側：畫面、動畫、連線、單機、阿禾的故事（跟雲端共用 src/game 的規則）
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/client", "src/story", "src/game", "src/server/protocol.ts"]
}
