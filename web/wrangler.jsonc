{
  // 蜜月橋牌網頁連線版
  // 部署：Cloudflare 後台 Workers → 建立 → 匯入 GitHub repo，根目錄填 web（細節見 web/README.md）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridgecard",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  // 正式網址 https://bridgecard.<帳戶子網域>.workers.dev 固定開著；預覽網址先不用
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // 頻率限制（每個來源一個，擋猜房號）
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  // 免費方案要用 SQLite 版的 Durable Object
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  "observability": { "enabled": true }
}
